{
    "layer": "top",
    "position": "top",
    "margin-top": 6,
    "margin-left": 96,
    "margin-right": 96,
    "height": 30,
    "spacing": 0,
    "spacing": 0,

    "modules-left": ["custom/void", "ext/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "pulseaudio"],

    "custom/void": {
        "format": "",
        "tooltip": false
    },

    "ext/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "I",
            "2": "II",
            "3": "III",
            "4": "IV",
            "5": "V",
            "6": "VI",
            "7": "VII",
            "8": "VIII",
            "9": "IX",
            "10": "X"
        },
        "ignore-hidden": false,
        "all-outputs": true,
        "active-only": false,
        "on-click": "activate",
        "sort-by-id": true
    },

    "clock": {
        "format": "{:%H:%M  %a %d %b}"
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "RAM {}%",
        "interval": 2
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "MUTE",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    }
}
